# Copy to .env and fill in what you need.
#
#   cp .env.example .env
#   set -a && source .env && set +a
#
# Measurement is entirely deterministic and needs no credentials. Keys are only
# required for the two features that call out to a model, and for production
# deployment of the web frontend.

# ── scorer ──────────────────────────────────────────────────────────────────

# Anthropic. Required by the two LLM-backed features:
#   - the free-text "additional context" box, where Claude Haiku extracts
#     structured acquisition metadata (~$0.0008 per submission)
#   - POST /chat, the streaming conversation about a finished scorecard
# Both fail without it. Nothing in the measurement pipeline (A0-A8) or the
# scorecard needs it — those are pure signal processing.
# Read implicitly by the Anthropic SDK, so it will not appear in the code.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# NASA APOD. Optional — DEMO_KEY works at 30 requests/hour, 50/day, which is
# enough to try things out. Image downloads come from apod.nasa.gov directly
# and never count against the limit; only metadata calls do.
# Free key at https://api.nasa.gov/
NASA_API_KEY=

# APODORNOT_UPLOAD_DIR=/tmp/apodornot_uploads
# APODORNOT_LOG_LEVEL=INFO

# ── web ─────────────────────────────────────────────────────────────────────

# Where the scorer is listening.
APODORNOT_PIPELINE_URL=http://127.0.0.1:8000

# Submission state.
REDIS_URL=redis://127.0.0.1:6379

# Gate the site behind a shared passcode. Unset means open access.
# APODORNOT_PASSCODE=

# Per-day cap on chat turns, which is what bounds Anthropic spend.
# 0 (the default) means no cap.
# APODORNOT_DAILY_CHAT_TURNS_CAP=0

# How long a submission and its uploaded image are retained. Default 14.
# SUBMISSION_TTL_DAYS=14

# Production only. Dev and test read a checked-in secret_key_base from config/;
# production reads this and refuses to boot without it: mix phx.gen.secret
# SECRET_KEY_BASE=
# PHX_HOST=example.com
# PORT=4000
